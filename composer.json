{
  "name": "panelis-php/database",
  "description": "Manage database backups, including manual backups, cloud uploads, and backup history",
  "license": "MIT",
  "keywords": [
    "panelis"
  ],
  "authors": [
    {
      "name": "Yugo",
      "email": "dedy.yugo.purwanto@gmail.com"
    }
  ],
  "type": "library",
  "require": {
    "php": "^8.4",
    "lorisleiva/laravel-actions": "^2.10",
    "illuminate/contracts": "^13.0",
    "illuminate/support": "^13.0",
    "filament/filament": "^5.0",
    "panelis-php/user": "^1.0",
    "panelis-php/setting": "^1.0",
    "panelis-php/activity": "^1.1"
  },
  "autoload": {
    "psr-4": {
      "Panelis\\Database\\": "src/",
      "Panelis\\Database\\Database\\Factories\\": "database/factories/",
      "Panelis\\Database\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Panelis\\Database\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panelis\\Database\\Providers\\DatabaseServiceProvider"
      ]
    },
    "panelis": {
      "plugins": [
        "Panelis\\Database\\Plugins\\DatabasePlugin"
      ],
      "permissions": {
        "database": "Panelis\\Database\\Panel\\Clusters\\Databases\\Enums\\DatabasePermission"
      }
    }
  },
  "require-dev": {
    "laravel/pint": "^1.29"
  }
}
